<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 内部存储私有文件目录 (对应 context.getFilesDir()) -->
    <files-path name="internal_files" path="." />

    <!-- 内部存储私有缓存目录 (对应 context.getCacheDir()) -->
    <cache-path name="internal_cache" path="." />

    <!-- 外部存储私有文件目录 (对应 context.getExternalFilesDir(null)) -->
    <external-files-path name="external_files" path="." />

    <!-- 外部存储私有缓存目录 (对应 context.getExternalCacheDir()) -->
    <external-cache-path name="external_cache" path="." />

    <!-- 外部存储根目录（Android 10+ 受限，仅适用于 targetSdk < 29 或 MANAGE_EXTERNAL_STORAGE） -->
    <external-path name="external_storage_root" path="." />

    <!-- 公共文档目录 (如 Documents/MyGameSaves) -->
    <external-path name="documents" path="Documents/" />

    <!-- 公共下载目录 (如 Download/MyGameExports) -->
    <external-path name="downloads" path="Download/" />
</paths>
